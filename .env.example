# =====================================================================
# Fichier de configuration du projet
# Copier ce fichier en ".env", puis remplacer les valeurs "remplacer_par_...".
# Le fichier ".env" contient vos mots de passe : il n'est jamais envoyé sur Git.
# Chaque réglage est expliqué par le commentaire juste au-dessus de lui.
# =====================================================================

# ---------------------------------------------------------------------
# Base de données PostgreSQL
# ---------------------------------------------------------------------
# Adresse de la base (laisser "localhost" : Docker la rend accessible sur votre poste)
PGHOST=localhost
# Port de la base sur votre poste (5432 est le port standard de PostgreSQL)
PGPORT=5432
# Nom de la base de données créée par le projet
PGDATABASE=emploie
# Nom de l'utilisateur de la base
PGUSER=postgres
# Mot de passe de la base (à choisir, par exemple "postgres")
PGPASSWORD=remplacer_par_le_mot_de_passe_postgresql

# ---------------------------------------------------------------------
# API France Travail (identifiants obtenus sur https://francetravail.io)
# Sans eux, la plateforme démarre mais ne récupère aucune offre réelle.
# ---------------------------------------------------------------------
# Identifiant de votre application francetravail.io
FT_CLIENT_ID=remplacer_par_votre_identifiant_client
# Clé secrète de votre application francetravail.io (à garder confidentielle)
FT_CLIENT_SECRET=remplacer_par_votre_secret_client
# Adresse qui délivre le "jeton" de connexion à l'API (ne pas modifier)
FT_TOKEN_URL=https://entreprise.francetravail.fr/connexion/oauth2/access_token?realm=/partenaire
# Droits demandés à l'API : lecture des offres d'emploi (ne pas modifier)
FT_SCOPE='api_offresdemploiv2 o2dsoffre'
# Adresse de l'API des offres d'emploi (ne pas modifier)
FT_API_BASE_URL=https://api.francetravail.io/partenaire/offresdemploi/v2

# ---------------------------------------------------------------------
# Kafka (la "boîte aux lettres" où transitent les offres)
# ---------------------------------------------------------------------
# Port pour se connecter à Kafka depuis votre poste
KAFKA_EXTERNAL_PORT=9094
# Identifiant interne du serveur Kafka (22 caractères, ne pas modifier)
KAFKA_KRAFT_CLUSTER_ID=abcdefghijklmnopqrstuv
# Nom de la file Kafka où sont déposées les offres brutes
FT_OFFERS_TOPIC=france-travail.offres.raw
# Nombre de sous-files Kafka (plus il y en a, plus la lecture peut être parallèle)
FT_OFFERS_TOPIC_PARTITIONS=3

# ---------------------------------------------------------------------
# Collecte des offres France Travail
# Les 4 filtres ci-dessous sont facultatifs : vide = pas de filtre.
# ---------------------------------------------------------------------
# Mots-clés à rechercher dans les offres (exemple : data)
FT_PRODUCER_MOTS_CLES=
# Code métier ROME à rechercher (exemple : M1805 pour le développement informatique)
FT_PRODUCER_CODE_ROME=
# Code INSEE d'une commune à cibler (exemple : 44109 pour Nantes)
FT_PRODUCER_COMMUNE=
# Numéro d'un département à cibler (exemple : 75 pour Paris)
FT_PRODUCER_DEPARTEMENT=
# Nombre d'offres récupérées par collecte quand on ne parcourt pas toute la France
FT_PRODUCER_MAX_RESULTS=50
# true = parcourir les 101 départements ; false = une seule recherche avec les filtres ci-dessus
FT_PRODUCER_ALL_DEPARTEMENTS=true
# Nombre maximum d'offres récupérées par département (0 = le maximum permis par l'API, 1 149)
FT_PRODUCER_MAX_PER_DEPARTEMENT=200
# Temps entre deux collectes, en secondes (900 = 15 minutes)
FT_PRODUCER_POLL_INTERVAL_SECONDS=900

# ---------------------------------------------------------------------
# Référentiel des communes (API Géo) et agrégation
# ---------------------------------------------------------------------
# Temps entre deux téléchargements de la liste des communes, en secondes (86400 = 1 jour)
COMMUNES_COLLECTION_INTERVAL_SECONDS=86400
# Au démarrage, temps d'attente maximum de la liste des communes, en secondes
STARTUP_COMMUNES_WAIT_SECONDS=60
# Temps entre deux relectures de la liste des communes par l'agrégateur, en secondes (300 = 5 minutes)
COMMUNES_REFRESH_SECONDS=300

# ---------------------------------------------------------------------
# Nettoyage PySpark
# ---------------------------------------------------------------------
# Temps entre deux nettoyages Spark, en secondes (1800 = 30 minutes)
SPARK_BATCH_INTERVAL_SECONDS=1800
# true = faire un seul nettoyage puis s'arrêter ; false = recommencer en boucle
SPARK_BATCH_RUN_ONCE=false
# Niveau de détail des journaux : DEBUG (très détaillé), INFO (normal), WARNING, ERROR
LOG_LEVEL=INFO

# ---------------------------------------------------------------------
# Ports des interfaces web (à changer seulement si un port est déjà utilisé)
# ---------------------------------------------------------------------
# Kafka UI : voir les messages Kafka (http://localhost:8080)
KAFKA_UI_PORT=8080
# Chiffres techniques du collecteur France Travail (http://localhost:8001/metrics)
FT_PRODUCER_METRICS_PORT=8001
# Chiffres techniques du collecteur de communes (http://localhost:8002/metrics)
COMMUNES_METRICS_PORT=8002
# Chiffres techniques de l'agrégateur (http://localhost:8003/metrics)
AGGREGATOR_METRICS_PORT=8003
# Prometheus : collecte des chiffres techniques (http://localhost:9090)
PROMETHEUS_PORT=9090
# Grafana : graphiques de surveillance (http://localhost:3001)
GRAFANA_PORT=3001
# Chiffres techniques de PostgreSQL (http://localhost:9187/metrics)
POSTGRES_EXPORTER_PORT=9187
# Chiffres techniques de Kafka (http://localhost:9308/metrics)
KAFKA_EXPORTER_PORT=9308
# Metabase : tableaux de bord métier (http://localhost:3000)
METABASE_PORT=3000
# cAdvisor : mémoire et processeur de chaque conteneur (http://localhost:8081)
CADVISOR_PORT=8081
# Plotly Dash : tableau de bord interactif (http://localhost:8050)
DATAVIZ_PORT=8050
# Temps entre deux mises à jour des données du tableau de bord Dash, en secondes
DATAVIZ_REFRESH_SECONDS=60

# ---------------------------------------------------------------------
# Comptes administrateur de Metabase et Grafana
# ---------------------------------------------------------------------
# E-mail du compte Metabase créé automatiquement (commande "metabase-setup")
MB_ADMIN_EMAIL=admin@example.local
# Mot de passe de ce compte Metabase
MB_ADMIN_PASSWORD=remplacer_par_un_mot_de_passe_metabase
# Prénom affiché pour ce compte Metabase
MB_ADMIN_FIRST_NAME=Projet
# Nom affiché pour ce compte Metabase
MB_ADMIN_LAST_NAME=Admin
# Nom d'utilisateur pour se connecter à Grafana
GRAFANA_ADMIN_USER=admin
# Mot de passe pour se connecter à Grafana
GRAFANA_ADMIN_PASSWORD=remplacer_par_un_mot_de_passe_grafana