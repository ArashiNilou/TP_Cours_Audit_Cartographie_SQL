PGHOST=localhost
PGPORT=5432
PGDATABASE=emploie
PGUSER=postgres
PGPASSWORD=remplacer_par_le_mot_de_passe_postgresql

# API France Travail (OAuth2 client credentials) - a completer localement
FT_CLIENT_ID=remplacer_par_votre_identifiant_client
FT_CLIENT_SECRET=remplacer_par_votre_secret_client
FT_TOKEN_URL=https://entreprise.francetravail.fr/connexion/oauth2/access_token?realm=/partenaire
FT_SCOPE=api_offresdemploiv2 o2dsoffre
FT_API_BASE_URL=https://api.francetravail.io/partenaire/offresdemploi/v2

# TP2 - Kafka / producteurs / Data Lake
KAFKA_EXTERNAL_PORT=9094
KAFKA_KRAFT_CLUSTER_ID=abcdefghijklmnopqrstuv
FT_OFFERS_TOPIC=france-travail.offres.raw
FT_OFFERS_TOPIC_PARTITIONS=3
FT_PRODUCER_MOTS_CLES=data
FT_PRODUCER_CODE_ROME=
FT_PRODUCER_COMMUNE=
FT_PRODUCER_DEPARTEMENT=
FT_PRODUCER_MAX_RESULTS=50
FT_PRODUCER_POLL_INTERVAL_SECONDS=900
COMMUNES_COLLECTION_INTERVAL_SECONDS=86400
STARTUP_COMMUNES_WAIT_SECONDS=60
COMMUNES_REFRESH_SECONDS=300
SPARK_BATCH_INTERVAL_SECONDS=1800
SPARK_BATCH_RUN_ONCE=false
LOG_LEVEL=INFO

# TP2 - ports UI et métriques
KAFKA_UI_PORT=8080
FT_PRODUCER_METRICS_PORT=8001
COMMUNES_METRICS_PORT=8002
AGGREGATOR_METRICS_PORT=8003
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
POSTGRES_EXPORTER_PORT=9187
KAFKA_EXPORTER_PORT=9308
METABASE_PORT=3000
CADVISOR_PORT=8081

# TP2 - Metabase / Grafana (remplacer en local, ne pas committer .env)
MB_ADMIN_EMAIL=admin@example.local
MB_ADMIN_PASSWORD=remplacer_par_un_mot_de_passe_metabase
MB_ADMIN_FIRST_NAME=TP2
MB_ADMIN_LAST_NAME=Admin
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=remplacer_par_un_mot_de_passe_grafana
