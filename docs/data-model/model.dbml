// TP - Tensions sur les compétences numériques et métiers d'avenir
// Domaine : Emploi, marché du travail et recrutement
// Modèle prêt à être copié dans https://dbdiagram.io

Table commune {
  code_insee char(5) [pk, note: "Code officiel INSEE de la commune"]
  code_postal varchar(5) [not null]
  nom_commune varchar(100) [not null]
  latitude decimal(9,6)
  longitude decimal(9,6)

  indexes {
    code_postal
    nom_commune
  }
}

Table entreprise {
  entreprise_id bigint [pk, increment]
  raison_sociale varchar(250) [note: "Nullable si entreprise_anonyme = true"]
  entreprise_anonyme boolean [not null, default: false]

  indexes {
    raison_sociale
  }
}

Table metier_rome {
  rome_code varchar(5) [pk, note: "Code ROME 4.0, ex. M1805"]
  libelle_fiche_metier varchar(250) [not null]
  domaine_professionnel varchar(150) [not null]

  indexes {
    domaine_professionnel
  }
}

Table competence {
  competence_id bigint [pk, increment]
  libelle_competence varchar(300) [not null, unique]
  type_competence varchar(20) [not null, note: "Savoir-faire ou Savoir-être"]
}

Table offre {
  offre_id bigint [pk, increment]
  source_offre_id varchar(20) [not null, unique, note: "Identifiant de l'offre côté API France Travail"]
  libelle_poste varchar(200) [not null]
  description text
  date_publication date [not null]
  type_contrat varchar(5) [not null, note: "CDI, CDD, MIS, SAI, CCE"]
  duree_travail varchar(100)
  salaire_brut_annuel_estime decimal(10,2) [note: "Valeur médiane extraite du texte libre de salaire"]
  rome_code varchar(5) [not null]
  entreprise_id bigint [not null]
  code_insee char(5) [not null]

  indexes {
    rome_code
    type_contrat
    code_insee
    date_publication
    (code_insee, type_contrat)
  }
}

Table exigence_offre {
  offre_id bigint [pk]
  competence_id bigint [pk]
  statut_exigence varchar(1) [not null, note: "E = Exigé, S = Souhaité"]
}

Ref: offre.rome_code > metier_rome.rome_code
Ref: offre.entreprise_id > entreprise.entreprise_id
Ref: offre.code_insee > commune.code_insee
Ref: exigence_offre.offre_id > offre.offre_id
Ref: exigence_offre.competence_id > competence.competence_id

// -----------------------------------------------------------------------------
// Tables techniques du pipeline (TP2) et de la qualité (TP3)
// Elles ne font pas partie du modèle métier 3NF mais complètent le schéma
// physique : traçabilité des traitements, enrichissement et audit qualité.
// -----------------------------------------------------------------------------

Table tp2_pipeline_run {
  run_id varchar(64) [pk, note: "UUID hexadécimal d'une exécution PySpark"]
  started_at timestamptz [not null, default: `now()`]
  completed_at timestamptz
  status varchar(20) [not null, note: "running, success, failed, no_input"]
  raw_count integer [not null, default: 0]
  clean_count integer [not null, default: 0]
  rejected_count integer [not null, default: 0]
  input_path text
  curated_path text
  quarantine_path text
  error_message text

  indexes {
    started_at [name: "idx_tp2_pipeline_run_started_at"]
  }
}

Table tp2_offre_enrichment {
  source_offre_id varchar(20) [pk, note: "FK vers offre.source_offre_id"]
  commune_reference_status varchar(20) [not null, note: "matched, not_found, missing_source2"]
  geo_nom_commune varchar(100)
  geo_code_postal varchar(5)
  geo_longitude decimal(9,6)
  geo_latitude decimal(9,6)
  aggregated_at timestamptz
}

Table tp3_quality_run {
  run_id bigint [pk, increment]
  phase varchar(30) [not null, note: "before_cleaning, after_cleaning, after_pipeline_reload, monitoring"]
  executed_at timestamptz [not null, default: `now()`]
  total_offres bigint [not null, default: 0]
  notes text
  baseline_run_id bigint [note: "Audit de référence pour la comparaison avant / après"]
}

Table tp3_quality_result {
  run_id bigint [pk]
  control_code varchar(10) [pk, note: "C01 à C17"]
  dimension varchar(20) [not null, note: "completude, unicite, validite, coherence, integrite"]
  control_label text [not null]
  severity varchar(10) [not null, note: "INFO, LOW, MEDIUM, HIGH"]
  anomaly_count bigint [not null]
  population_count bigint [not null]
  anomaly_rate_pct decimal(8,4) [not null]
  result_status varchar(10) [not null, note: "PASS, WARN, FAIL"]
  decision text [not null]

  indexes {
    (run_id, dimension) [name: "idx_tp3_quality_result_dimension"]
  }
}

Table tp3_cleaning_log {
  cleaning_id bigint [pk, increment]
  executed_at timestamptz [not null, default: `now()`]
  rule_code varchar(20) [not null, note: "R01_COMPETENCE, R02_ENTREPRISE, R03_SALAIRE, R04_DOMAINE_ROME"]
  table_name varchar(100) [not null]
  record_key text [not null]
  column_name varchar(100) [not null]
  old_value text
  new_value text
  justification text [not null]

  indexes {
    (rule_code, executed_at) [name: "idx_tp3_cleaning_log_rule"]
  }
}

Ref: tp2_offre_enrichment.source_offre_id - offre.source_offre_id [delete: cascade, update: cascade]
Ref: tp3_quality_result.run_id > tp3_quality_run.run_id [delete: cascade]
Ref: tp3_quality_run.baseline_run_id > tp3_quality_run.run_id [delete: set null]

TableGroup metier_3nf {
  commune
  entreprise
  metier_rome
  competence
  offre
  exigence_offre
}

TableGroup pipeline_tp2 {
  tp2_pipeline_run
  tp2_offre_enrichment
}

TableGroup qualite_tp3 {
  tp3_quality_run
  tp3_quality_result
  tp3_cleaning_log
}